# ==============================================================================
# SmartHostel Environment Configuration Template
# NOTE: Replace placeholder values with your actual production secrets.
# Never commit real credentials or actual passwords to Git.
# ==============================================================================

# Database Connection URL:
# For local development:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/smarthostel
#
# For Render PostgreSQL (Internal connection within Render):
# DATABASE_URL=postgresql://dbadmin:<password>@dpg-xxxxxxxx-a:5432/smarthostel
#
# For Render PostgreSQL (External connection for seeding/local scripts):
DATABASE_URL=postgresql://dbadmin:<your_database_password>@<render_host>.render.com:5432/smarthostel?sslmode=require

# JWT Authentication Secret Key (Generate a random 64-char string for production):
JWT_SECRET=your_production_jwt_secret_key_minimum_32_characters_random

# Application Server Binding:
PORT=8000
HOST=0.0.0.0

# CORS Whitelist (comma-separated origins allowed to make browser API requests):
# Example: https://smarthostel-frontend.onrender.com,http://localhost:5173
ALLOWED_ORIGINS=https://your-frontend-app.onrender.com
